---
// Build-time map of talk locations: rendered to static SVG, no client-side JS or map tiles.
import { geoMercator, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
import type { FeatureCollection, MultiPoint } from 'geojson';
import world from 'world-atlas/countries-50m.json';
import type { Talk } from '../lib/entries';

interface Props {
  talks: Talk[];
}
const { talks } = Astro.props;

const W = 800;
const H = 420;

// One marker per place; several talks in the same city share it.
type Place = { name: string; lat: number; lng: number; talks: Talk[] };
const places = new Map<string, Place>();
for (const t of talks) {
  const [lat, lng] = t.data.coordinates;
  const key = `${lat},${lng}`;
  const city = t.data.location.split(',')[0].trim();
  if (!places.has(key)) places.set(key, { name: city, lat, lng, talks: [] });
  places.get(key)!.talks.push(t);
}
const list = [...places.values()];

// Frame the points, but never zoom in closer than roughly a region of Europe.
const lats = list.map((p) => p.lat);
const lngs = list.map((p) => p.lng);
const midLat = (Math.min(...lats) + Math.max(...lats)) / 2;
const midLng = (Math.min(...lngs) + Math.max(...lngs)) / 2;
const halfLng = Math.max((Math.max(...lngs) - Math.min(...lngs)) / 2 * 1.35, 14);
const halfLat = Math.max((Math.max(...lats) - Math.min(...lats)) / 2 * 1.35, 8);
// Fit to the two corner points. (A Polygon here would be read as a spherical ring, and
// the wrong winding order means "the whole globe except this box", which zooms out to the world.)
const frame: MultiPoint = {
  type: 'MultiPoint',
  coordinates: [
    [midLng - halfLng, midLat - halfLat],
    [midLng + halfLng, midLat + halfLat],
  ],
};

const projection = geoMercator().fitExtent([[24, 24], [W - 24, H - 24]], frame);
// Drop everything outside the frame so only the visible coastline ends up in the HTML.
projection.clipExtent([[0, 0], [W, H]]);
const path = geoPath(projection).digits(1);

const countries = feature(world as any, (world as any).objects.countries) as unknown as FeatureCollection;
const land = countries.features.map((f) => path(f)).filter(Boolean).join('');

const markers = list.map((p) => {
  const [x, y] = projection([p.lng, p.lat])!;
  const href = p.talks.length === 1 ? p.talks[0].data.permalink + '/' : `/talks/#talk-${p.talks[0].id}`;
  const label = `${p.name}: ${p.talks.map((t) => t.data.title).join('; ')}`;
  const anchorEnd = x > W * 0.7;
  return { ...p, x, y, href, label, anchorEnd };
});

const cityCount = list.length;
const talkCount = talks.length;
---
<figure class="talk-map" id="map">
  <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-labelledby="map-title">
    <title id="map-title">Map of talk locations</title>
    <rect class="sea" width={W} height={H} />
    <path class="land" d={land} />
    {markers.map((m) => (
      <a href={m.href} aria-label={m.label}>
        <title>{m.label}</title>
        <circle class="halo" cx={m.x} cy={m.y} r="14" />
        <circle class="dot" cx={m.x} cy={m.y} r="6" />
        <text
          class={m.anchorEnd ? 'end' : 'start'}
          x={m.anchorEnd ? m.x - 14 : m.x + 14}
          y={m.y + 5}
          text-anchor={m.anchorEnd ? 'end' : 'start'}
        >
          {m.name}{m.talks.length > 1 ? ` (${m.talks.length})` : ''}
        </text>
      </a>
    ))}
  </svg>
  <figcaption>{talkCount} {talkCount === 1 ? 'talk' : 'talks'} in {cityCount} {cityCount === 1 ? 'city' : 'cities'}</figcaption>
</figure>

<style>
  .talk-map {
    margin: 0 0 var(--space-6);
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .sea { fill: var(--surface); }
  .land {
    fill: color-mix(in srgb, var(--faint) 24%, var(--surface));
    stroke: var(--paper);
    stroke-width: 0.75;
    stroke-linejoin: round;
  }

  .halo { fill: var(--accent); opacity: 0.18; }
  .dot { fill: var(--accent); stroke: var(--surface); stroke-width: 2; }

  text {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  a:hover .halo,
  a:focus-visible .halo { opacity: 0.35; }
  a:hover text,
  a:focus-visible text { fill: var(--accent-ink); }
  a:focus-visible { outline: none; }
  a:focus-visible .dot { stroke: var(--ink); }

  /* The SVG scales down on phones; scale labels and markers back up so they stay legible. */
  @media (max-width: 40rem) {
    text { font-size: 30px; stroke-width: 7px; }
    .dot { r: 10px; stroke-width: 3; }
    .halo { r: 22px; }
    text { dominant-baseline: middle; }
    text.start { transform: translateX(10px); }
    text.end { transform: translateX(-10px); }
  }

  figcaption {
    margin-top: var(--space-2);
    font-size: var(--step--1);
    color: var(--faint);
  }
</style>
