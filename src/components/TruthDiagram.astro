---
// A worked picture of truth discovery: sources with reliability weights back conflicting claims,
// and the claim supported by the most reliable sources wins. Static SVG with one load animation.

const sources = [
  { id: 'A', reliability: 0.9, claim: 0 },
  { id: 'B', reliability: 0.8, claim: 0 },
  { id: 'C', reliability: 0.35, claim: 1 },
  { id: 'D', reliability: 0.7, claim: 0 },
  { id: 'E', reliability: 0.2, claim: 2 },
];
const claims = ['Claim 1', 'Claim 2', 'Claim 3'];

const W = 640;
const H = 300;
const srcX = 44;
const barX = 72;
const barW = 84;
const edgeX0 = 172;
const claimX = 430;
const claimW = 170;
const srcY = (i: number) => 76 + i * 48;
const claimY = (i: number) => 104 + i * 66;

const scores = claims.map((_, c) => sources.filter((s) => s.claim === c).reduce((sum, s) => sum + s.reliability, 0));
const best = scores.indexOf(Math.max(...scores));
const maxScore = Math.max(...scores);

const edges = sources.map((s, i) => {
  const y0 = srcY(i);
  const y1 = claimY(s.claim);
  return {
    d: `M${edgeX0},${y0} C${edgeX0 + 130},${y0} ${claimX - 120},${y1} ${claimX},${y1}`,
    width: 1 + s.reliability * 5,
    win: s.claim === best,
    delay: 150 + i * 90,
  };
});

const label =
  'Diagram: five sources, A to E, each with a reliability weight, back three conflicting claims. ' +
  'Sources A, B and D are the most reliable and all back Claim 1, so Claim 1 is taken as true.';
---
<figure class="truth">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label}>
    <text class="head" x={srcX - 15} y="34">Sources and their reliability</text>
    <text class="head" x={claimX} y="34">Conflicting claims</text>

    {edges.map((e) => (
      <path
        class:list={['edge', { win: e.win }]}
        d={e.d}
        pathLength="1"
        stroke-width={e.width}
        style={`--d:${e.delay}ms`}
      />
    ))}

    {sources.map((s, i) => (
      <g class="source" style={`--d:${100 + i * 90}ms`}>
        <circle cx={srcX} cy={srcY(i)} r="15" />
        <text class="letter" x={srcX} y={srcY(i) + 5} text-anchor="middle">{s.id}</text>
        <rect class="track" x={barX} y={srcY(i) - 3} width={barW} height="6" rx="3" />
        <rect class="bar" x={barX} y={srcY(i) - 3} width={barW * s.reliability} height="6" rx="3" />
      </g>
    ))}

    {claims.map((c, i) => (
      <g class:list={['claim', { best: i === best }]}>
        <rect class="pill" x={claimX} y={claimY(i) - 22} width={claimW} height="44" rx="8" />
        <text class="claim-label" x={claimX + 14} y={claimY(i) - 1}>{c}</text>
        <rect class="track" x={claimX + 14} y={claimY(i) + 9} width={claimW - 28} height="4" rx="2" />
        <rect class="score" x={claimX + 14} y={claimY(i) + 9} width={(claimW - 28) * (scores[i] / maxScore)} height="4" rx="2" />
        {i === best && <text class="verdict" x={claimX + claimW - 14} y={claimY(i) - 1} text-anchor="end">trusted</text>}
      </g>
    ))}
  </svg>
  <figcaption>
    Truth discovery in one picture: sources that tend to be right earn more weight, and the claim backed by the most
    reliable sources wins. A reputation system keeps those weights from one run to the next.
  </figcaption>
</figure>

<style>
  .truth { margin: 0; }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  text { font-family: var(--font-sans); }
  .head { font-size: 13px; fill: var(--faint); }

  .source circle { fill: var(--surface); stroke: var(--rule); stroke-width: 1.5; }
  .letter { font-size: 14px; font-weight: 600; fill: var(--ink); }
  .track { fill: var(--rule); }
  .bar { fill: var(--accent); }

  .edge { fill: none; stroke: var(--rule); stroke-linecap: round; }
  .edge.win { stroke: var(--accent); opacity: 0.55; }

  .pill { fill: var(--surface); stroke: var(--rule); stroke-width: 1.5; }
  .claim-label { font-size: 15px; font-weight: 500; fill: var(--muted); }
  .score { fill: var(--faint); }
  .verdict { font-size: 13px; font-weight: 600; fill: var(--accent-ink); }

  .best .pill { stroke: var(--accent); stroke-width: 2; }
  .best .claim-label { fill: var(--ink); font-weight: 600; }
  .best .score { fill: var(--accent); }

  figcaption {
    margin-top: var(--space-3);
    font-size: var(--step--1);
    color: var(--muted);
    max-width: 60ch;
  }

  /* One orchestrated sequence: weights fill, evidence flows, the winning claim lights up. */
  @media (prefers-reduced-motion: no-preference) {
    .bar,
    .score {
      transform-box: fill-box;
      transform-origin: left center;
      animation: grow 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: var(--d, 0ms);
    }
    .source .bar { animation-delay: var(--d); }
    .claim .score { animation-delay: 1100ms; }

    .edge {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: draw 800ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
      animation-delay: calc(var(--d) + 350ms);
    }

    .best .pill,
    .best .claim-label,
    .verdict {
      animation: settle 500ms ease-out both;
      animation-delay: 1650ms;
    }

    @keyframes grow { from { transform: scaleX(0); } }
    @keyframes draw { to { stroke-dashoffset: 0; } }
    @keyframes settle {
      from { stroke: var(--rule); fill-opacity: 0.6; opacity: 0.6; }
    }
  }

  /* The SVG scales down to about half size on phones; enlarge its text to stay readable (~11px). */
  @media (max-width: 40rem) {
    .head { font-size: 21px; }
    .source circle { r: 18px; }
    .letter { font-size: 20px; }
    .claim-label { font-size: 22px; }
    /* The highlighted outline already marks the winner; the tag would collide with the label. */
    .verdict { display: none; }
  }
</style>
