---
import Base from '../layouts/Base.astro';
import { courseName, courseTopics, getCourses } from '../lib/entries';

const courses = await getCourses();
---
<Base title="Teaching" description="Courses Diogo Ribeiro teaches at the University of Minho.">
  <h1>Teaching</h1>

  <ol class="courses">
    {courses.map((c) => (
      <li>
        <p class="term">{c.data.title}</p>
        <div>
          <h2>{courseName(c)}</h2>
          <p class="meta">{c.data.type}, {c.data.venue}</p>
          <ul class="topics">
            {courseTopics(c).map((t) => <li>{t}</li>)}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</Base>

<style>
  h1 { margin-bottom: var(--space-6); }

  .courses { list-style: none; padding: 0; margin: 0; }
  .courses > li {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: var(--space-2) var(--space-5);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--rule);
  }
  .term { margin: 0; color: var(--faint); font-size: var(--step--1); padding-top: 0.2rem; font-variant-numeric: tabular-nums; }

  h2 { font-size: var(--step-1); margin: 0 0 var(--space-1); }
  .meta { margin: 0 0 var(--space-3); color: var(--muted); font-size: var(--step--1); }

  .topics { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; padding: 0; margin: 0; }
  .topics li {
    padding: 0.1rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: var(--step--1);
    color: var(--muted);
  }

  @media (max-width: 40rem) {
    .courses > li { grid-template-columns: 1fr; }
  }
</style>
