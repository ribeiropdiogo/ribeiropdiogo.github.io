---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import TruthDiagram from '../components/TruthDiagram.astro';
import { Content as About } from '../content/pages/about.md';
import { getTimeline } from '../lib/entries';
import { getImage } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import { SITE, LINKS } from '../site';

const photo = await getImage({ src: avatar, width: 512, height: 512, format: 'jpg' });
const recent = (await getTimeline()).slice(0, 6);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  image: new URL(photo.src, SITE.url).href,
  email: `mailto:${SITE.email}`,
  jobTitle: SITE.roles.map((r) => r.title),
  affiliation: [...new Set(SITE.roles.map((r) => r.org))].map((name) => ({ '@type': 'Organization', name })),
  address: { '@type': 'PostalAddress', addressLocality: 'Braga', addressCountry: 'PT' },
  knowsAbout: ['Truth discovery', 'Reputation systems', 'Data fusion', 'Information security'],
  sameAs: LINKS.map((l) => l.href),
};
---
<Base type="profile">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <header class="hero">
    <h1>Hi, I'm Diogo.</h1>
    <p class="lede">
      I'm a PhD student in Informatics at the University of Minho and a Research Assistant at HasLab,
      INESC TEC, in Braga. I work on <strong>truth discovery</strong> and <strong>reputation systems</strong>: methods
      that learn how reliable each source is, so conflicting information can be resolved in favour of the sources
      that have earned trust.
    </p>
    <p class="lede">
      I also work on <strong>information security</strong>, from large-scale assessments of the security of online
      public services to teaching cryptography and security at the University of Minho.
    </p>
  </header>

  <div class="diagram">
    <TruthDiagram />
  </div>

  <section aria-labelledby="recent-title">
    <div class="section-head">
      <h2 id="recent-title">Recent</h2>
      <a href="/cv/">Full history in the CV</a>
    </div>
    <Timeline items={recent} label="Recent papers, talks and teaching" />
  </section>

  <section class="about" aria-labelledby="about-title">
    <h2 id="about-title">About me</h2>
    <div class="prose">
      <About />
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero h1 {
    font-size: clamp(2.1rem, 1.4rem + 2.6vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    max-width: 17ch;
    margin-bottom: var(--space-5);
  }

  .lede {
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--muted);
    max-width: 60ch;
    margin-bottom: var(--space-4);
  }
  .lede:last-of-type { margin-bottom: 0; }
  .lede strong { color: var(--ink); font-weight: 600; }

  .diagram {
    margin: var(--space-7) 0 0;
    padding: var(--space-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 60%, var(--paper));
  }

  section { margin-top: var(--space-8); }

  /* ---------- Recent ---------- */
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-5);
  }
  .section-head h2 { margin: 0; }
  .section-head a { font-size: var(--step--1); }

  /* ---------- About ---------- */
  .about .prose :global(p) { color: var(--muted); }
  .about .prose :global(h2) { font-size: var(--step-1); margin-top: var(--space-6); }

  @media (prefers-reduced-motion: no-preference) {
    .hero { animation: rise 500ms cubic-bezier(0.2, 0.7, 0.2, 1) both; }
    @keyframes rise {
      from { opacity: 0; transform: translateY(6px); }
    }
  }

  @media (max-width: 30rem) {
    .diagram { padding: var(--space-3); }
  }
</style>
