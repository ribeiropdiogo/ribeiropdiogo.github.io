---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDay, getPublications, getTalks, isoDate, slugFromPermalink, type Talk } from '../../lib/entries';

export async function getStaticPaths() {
  const talks = await getTalks();
  return talks.map((talk) => ({ params: { slug: slugFromPermalink(talk.data.permalink) }, props: { talk } }));
}

const { talk } = Astro.props as { talk: Talk };
const { title, venue, location, date, type } = talk.data;
const { Content } = await render(talk);
const paper = (await getPublications()).find((p) => p.data.title === title);
---
<Base title={title} description={`${type} at ${venue}${location ? `, ${location}` : ''}.`} type="article">
  <p class="back"><a href="/talks/">All talks</a></p>

  <article>
    <h1>{title}</h1>
    <dl class="facts">
      <div><dt>Type</dt><dd>{type}</dd></div>
      <div><dt>Venue</dt><dd>{venue}</dd></div>
      {location && <div><dt>Where</dt><dd>{location}</dd></div>}
      <div><dt>Date</dt><dd><time datetime={isoDate(date)}>{formatDay(date)}</time></dd></div>
      {paper && <div><dt>Paper</dt><dd><a href={paper.data.permalink + '/'}>Publication page</a></dd></div>}
    </dl>

    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .back { font-size: var(--step--1); margin-bottom: var(--space-5); }
  h1 { font-size: var(--step-3); }

  .facts { display: grid; gap: var(--space-2); margin: 0 0 var(--space-6); }
  .facts div { display: grid; grid-template-columns: 4.5rem 1fr; gap: var(--space-4); }
  dt { color: var(--faint); font-size: var(--step--1); padding-top: 0.15rem; }
  dd { margin: 0; }

  .prose { padding-top: var(--space-5); border-top: 1px solid var(--rule); }
  .prose :global(p:first-child) { font-weight: 500; }
</style>
