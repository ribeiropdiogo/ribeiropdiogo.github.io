---
import Base from '../layouts/Base.astro';
import PubLinks from '../components/PubLinks.astro';
import { CATEGORY_LABELS, getPublications, getTalks } from '../lib/entries';
import { LINKS } from '../site';

const pubs = await getPublications();
const talks = await getTalks();
const talkFor = (title: string) => talks.find((t) => t.data.title === title);

// Same group order as the old site.
const order = ['books', 'manuscripts', 'conferences', 'reports'] as const;
const groups = order
  .map((cat) => ({ cat, label: CATEGORY_LABELS[cat], items: pubs.filter((p) => p.data.category === cat) }))
  .filter((g) => g.items.length > 0);

const scholar = LINKS.find((l) => l.label === 'Google Scholar')!.href;
---
<Base title="Publications" description="Journal articles, conference papers and reports by Diogo Ribeiro.">
  <h1>Publications</h1>
  <p class="lede">You can also find my articles on <a href={scholar}>my Google Scholar profile</a>.</p>

  {groups.map((g) => (
    <section aria-labelledby={`g-${g.cat}`}>
      <h2 id={`g-${g.cat}`}>{g.label} <span class="count">{g.items.length}</span></h2>
      <ol class="pubs">
        {g.items.map((p) => (
          <li>
            <span class="year mono">{p.data.date.getUTCFullYear()}</span>
            <div>
              <h3><a href={p.data.permalink + '/'}>{p.data.title}</a></h3>
              <p class="venue">{p.data.venue}</p>
              <PubLinks pub={p} talk={talkFor(p.data.title)} />
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}
</Base>

<style>
  .lede { color: var(--muted); margin-bottom: var(--space-7); }

  section + section { margin-top: var(--space-7); }

  h2 { display: flex; align-items: baseline; gap: var(--space-2); }
  .count {
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  .pubs { list-style: none; padding: 0; margin: 0; }
  .pubs li {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--rule);
  }
  .year { color: var(--faint); padding-top: 0.2rem; }

  h3 {
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.4;
    margin: 0 0 var(--space-1);
  }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-color: var(--accent); }

  .venue { margin: 0; color: var(--muted); font-size: var(--step--1); line-height: 1.5; }
</style>
